.stamp__pre{font-weight:600;font-size:1.05rem}
.stamp__num{font-family:var(--disp);font-weight:800;font-size:clamp(4.2rem,15vw,15rem);line-height:.82;letter-spacing:-.06em}
.stamp__post{max-width:44ch;font-size:1.08rem}

/* ============================================================
   SELFIEBOX
   ============================================================ */
.sb-hero{min-height:100svh;height:max(100svh,680px);padding-top:clamp(7rem,13vh,9.5rem);padding-bottom:clamp(1.5rem,4vh,2.5rem);display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:clamp(1.4rem,3vh,2.4rem);overflow:hidden}
.sb-hero h1{font-size:clamp(3rem,8.6vw,9.6rem);line-height:.88}
.sb-hero h1 span{display:block}
.sb-hero h1 span+span{padding-left:clamp(2rem,16vw,18rem)}
.stripe{min-height:0;container-type:size;display:grid;place-items:center}
.stripe__paper{--n:3;background:var(--bone);padding:10px;display:flex;gap:10px;box-shadow:var(--shadow);width:min(calc(100cqw - 2rem),calc((100cqh - 24px) * 1.5 * var(--n) + 10px * (var(--n) + 1)));transform:rotate(-1.2deg)}
.stripe__paper img{flex:1 1 0;min-width:0;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}
.sb-hero__foot{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:end}
.sb-hero__foot p{grid-column:1/span 5}
.sb-hero__foot .btn{grid-column:10/span 3;justify-self:end}
.sb-hero__foot .from{grid-column:7/span 3;font-family:var(--disp);font-weight:700;font-size:clamp(1.5rem,2.2vw,2.1rem);letter-spacing:-.03em;line-height:1}
.sb-hero__foot .from small{display:block;font-family:var(--body);font-weight:500;font-size:.95rem;letter-spacing:0;color:var(--moss);margin-top:.35rem}

.how{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:start}
.how__frame{grid-column:1/span 6;position:sticky;top:6.5rem}
.how__frame .print{padding-bottom:40px}
.how__stack{position:relative;aspect-ratio:3/2;overflow:hidden;background:var(--felt-2)}
.how__stack img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .6s var(--ease)}
.how__stack img.on{opacity:1}
.how__frame figcaption{font-size:.9rem;bottom:11px}
.how__steps{grid-column:8/span 5}
.how__steps h2{margin-bottom:2rem}
.how__steps ol{counter-reset:s}
.how__steps li{counter-increment:s;padding-block:clamp(3rem,12vh,7rem) clamp(1rem,3vh,2rem);border-top:1px solid var(--hair-ink);opacity:.42;transition:opacity .5s}
.how__steps li.on{opacity:1}
.how__steps li::before{content:counter(s);display:block;font-family:var(--disp);font-weight:800;font-size:clamp(3rem,5vw,5rem);line-height:.9;letter-spacing:-.05em;margin-bottom:1rem}
.how__steps li h3{font-family:var(--disp);font-weight:700;font-size:1.6rem;letter-spacing:-.025em;margin-bottom:.5rem}
.how__steps li p{color:var(--ink-2)}
.how__qr{margin-top:3rem;padding:1.6rem;background:var(--ink);color:var(--bone)}
.how__qr h3{font-family:var(--disp);font-weight:700;font-size:1.35rem;margin-bottom:.4rem}

.pkg table{width:100%;border-collapse:collapse;margin-top:clamp(2.5rem,5vw,4rem)}
.pkg th,.pkg td{text-align:left;padding:1.4rem 1rem 1.4rem 0;border-bottom:1px solid var(--hair);vertical-align:bottom}
.pkg thead th{font-family:var(--disp);font-weight:800;font-size:clamp(2.2rem,4.4vw,4.6rem);letter-spacing:-.045em;line-height:.9;border-bottom:1px solid var(--bone)}
.pkg thead th:first-child{font-family:var(--body);font-size:.86rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--moss);vertical-align:bottom}
.pkg tbody th{font-weight:500;color:var(--moss);width:24%}
.pkg td{font-family:var(--disp);font-weight:600;font-size:clamp(1.2rem,1.9vw,1.8rem);letter-spacing:-.02em}
.pkg td .btn{font-family:var(--body);font-size:.95rem;letter-spacing:0;min-height:2.9rem;padding:.7rem 1.1rem}
.pkg__all{margin-top:2.4rem;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem}
.pkg__all p{grid-column:1/span 7;color:var(--moss)}
.pkg__all a{grid-column:9/span 4;justify-self:end}

.boxes{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:center}
.boxes__img{grid-column:1/span 7}
.boxes__img img{width:100%;box-shadow:var(--shadow)}
.boxes__text{grid-column:9/span 4;display:grid;gap:1.3rem}
.boxes__big{font-family:var(--disp);font-weight:800;font-size:clamp(5rem,11vw,11rem);line-height:.8;letter-spacing:-.06em}

.bento{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:clamp(12rem,19vw,19rem);grid-auto-flow:dense;gap:clamp(.8rem,1.4vw,1.3rem);margin-top:clamp(2rem,4vw,3rem)}
.bento figure{position:relative;overflow:hidden;background:var(--felt-2)}
.bento img{width:100%;height:100%;object-fit:cover}
.bento .b1{grid-column:1/span 8;grid-row:span 2}
.bento .b2{grid-column:9/span 4}
.bento .b3{grid-column:9/span 4}
.bento .b4{grid-column:1/span 4}
.bento .b5{grid-column:5/span 8}
.bento .b4 img{object-position:50% 12%}
.bento .b5 img{object-position:50% 30%}
.bento figcaption{position:absolute;left:.8rem;bottom:.8rem;background:var(--bone);color:var(--ink);font-size:.82rem;padding:.3rem .55rem;font-weight:600}

.space{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:end}
.space__big{grid-column:1/span 7;font-family:var(--disp);font-weight:800;font-size:clamp(6rem,19vw,20rem);line-height:.78;letter-spacing:-.07em;color:var(--ink)}
.space__big small{display:block;font-size:.2em;letter-spacing:-.02em;font-weight:700;margin-top:.5em;color:var(--ink-2)}
.space__text{grid-column:8/span 5;display:grid;gap:1.1rem;justify-items:start;padding-bottom:1rem}

/* ============================================================
   HÁTTEREK
   ============================================================ */
.hb-hero{padding-top:clamp(6.4rem,12vh,8.5rem);padding-bottom:clamp(3rem,6vw,5rem)}
.hb-hero__top{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:end;margin-bottom:clamp(1.4rem,3vh,2.4rem)}
.hb-hero h1{font-size:clamp(2.8rem,6.4vw,6.8rem);line-height:.9}
.hb-hero h1{grid-column:1/span 7}
.hb-hero__spec{grid-column:9/span 4;display:grid;gap:.6rem}
.hb-hero__spec b{font-family:var(--disp);font-weight:800;font-size:clamp(2rem,3.2vw,3.2rem);letter-spacing:-.04em;line-height:1}
.swatches{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(.6rem,1vw,1rem);width:min(100%,calc((100svh - var(--hb-top,16rem) - 90px) * 3))}
.swatch{position:relative;display:block;width:100%;padding:0;border:0;background:var(--bone);cursor:zoom-in;text-align:left;box-shadow:var(--shadow);transition:transform .45s var(--ease)}
.swatch img{width:100%;aspect-ratio:1;object-fit:cover}
.swatch span{display:flex;justify-content:space-between;padding:.55rem .6rem .6rem;color:var(--ink);font-weight:600;font-size:.92rem}

.rf-hero__text{position:absolute;left:var(--pad);right:var(--pad);bottom:calc(6vh + clamp(1.4rem,4vh,2.6rem));display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:end}

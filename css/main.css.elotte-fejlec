.inc__note{grid-column:8/span 5;margin-top:1.6rem;color:var(--ink-2);font-size:.98rem}

.char{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:center}
.char__img{grid-column:1/span 7}

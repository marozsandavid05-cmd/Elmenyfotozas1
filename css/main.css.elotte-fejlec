.cmp td strong{display:block;color:var(--ink);font-family:var(--disp);font-weight:700;font-size:1.3rem;letter-spacing:-.02em;margin-bottom:.3rem}
.cmp__safe{margin-top:2.4rem;padding:1.6rem 1.8rem;background:var(--ink);color:var(--bone);display:grid;gap:.5rem}

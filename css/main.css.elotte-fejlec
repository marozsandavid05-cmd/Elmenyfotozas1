.site-ask .print{max-width:21rem;transform:rotate(2deg)}

/* ============================================================
   AI SELFIE
   ============================================================ */
.ai-hero{height:max(100svh,660px);display:grid;grid-template-rows:auto minmax(0,1fr);padding-top:clamp(7rem,13vh,9.5rem);padding-bottom:calc(6vh + 1.2rem);overflow:hidden;position:relative}
.ai-hero__text{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:end;position:relative;z-index:3}

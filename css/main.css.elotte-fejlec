.tu-send{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;align-items:end}
.tu-send h2{grid-column:1/span 8}
.tu-send div{grid-column:9/span 4;display:grid;gap:1rem;justify-items:start}


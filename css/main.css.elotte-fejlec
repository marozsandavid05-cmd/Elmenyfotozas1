.sheet.is-h{height:var(--hh,300vh);padding-block:0}
.sheet__ctrl{display:flex;justify-content:flex-end;margin-top:.4rem}
.sheet.is-h .sheet__pin{position:sticky;top:0;height:100svh;display:flex;flex-direction:column;justify-content:center;overflow:hidden}
.sheet.is-h .sheet__track{overflow:visible;scroll-snap-type:none;width:max-content;will-change:transform}

.quote-full{position:relative}
.quote-full__img{height:min(88svh,60vw);overflow:hidden;-webkit-mask-image:linear-gradient(transparent,#000 22%,#000 70%,transparent);mask-image:linear-gradient(transparent,#000 22%,#000 70%,transparent)}
.quote-full__img img{width:100%;height:100%;object-fit:cover}
.quote-full__text{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem;margin-top:-10vh;position:relative}
.quote-full__text h2{grid-column:5/span 8}
.quote-full__text p{grid-column:5/span 5;margin-top:1.6rem}
.kinds{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem;grid-column:5/span 8}
.kinds a{padding:.7rem 1.1rem;box-shadow:inset 0 0 0 1.5px var(--hair);border-radius:2px;min-height:44px;display:inline-flex;align-items:center;transition:background-color .3s,color .3s,box-shadow .3s}
.kinds a:hover{background:var(--bone);color:var(--ink);box-shadow:none}

/* ============================================================
   TUDNIVALÓK
   ============================================================ */
.tu-hero{min-height:100svh;display:grid;align-content:end;padding-top:clamp(8rem,17vh,12rem);padding-bottom:clamp(3.4rem,9vh,6rem)}

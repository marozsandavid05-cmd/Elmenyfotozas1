.cmp thead th{position:sticky;top:0;background:var(--bone);font-family:var(--disp);font-weight:800;font-size:clamp(1.5rem,2.3vw,2.3rem);letter-spacing:-.03em;line-height:1;text-align:left;padding:1.3rem 1.2rem 1rem 0;border-bottom:2px solid var(--ink);z-index:1}

.hb-note div{grid-column:8/span 5;display:flex;flex-wrap:wrap;gap:1rem;justify-content:flex-end}
.viewer{border:0;padding:0;background:transparent;color:var(--bone);max-width:none;max-height:none;width:100vw;height:100svh;margin:0}

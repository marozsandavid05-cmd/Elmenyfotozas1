.prices .h{font-family:var(--disp);font-weight:800;font-size:clamp(1.9rem,3vw,2.9rem);letter-spacing:-.04em;line-height:1}
.prices .p{font-family:var(--disp);font-weight:600;font-size:clamp(1.3rem,1.9vw,1.8rem);letter-spacing:-.02em}
.prices .go{font-weight:600;display:inline-flex;gap:.4rem;align-items:center}
.prices .go svg{width:1em;height:1em}
.inc__list{grid-column:8/span 5}
.inc__list h3{font-family:var(--disp);font-weight:700;font-size:1.4rem;letter-spacing:-.02em;margin-bottom:1rem}
.inc__list ul{display:grid;gap:.55rem}
.inc__list li{display:grid;grid-template-columns:1.3rem minmax(0,1fr);gap:.8rem;align-items:start}

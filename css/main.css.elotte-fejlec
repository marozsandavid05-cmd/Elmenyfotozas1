.viewer__in{height:100%;display:grid;grid-template-columns:minmax(0,1fr) minmax(16rem,24rem);gap:clamp(1.5rem,3vw,3rem);align-items:center;padding:clamp(1rem,4vw,3rem)}
.viewer__img{background:var(--bone);padding:10px;box-shadow:var(--shadow);justify-self:center;max-height:calc(100svh - 4rem);aspect-ratio:1;height:100%;max-width:100%}
.viewer__img img{width:100%;height:100%;object-fit:contain}
.viewer__side{display:grid;gap:1.2rem;justify-items:start}

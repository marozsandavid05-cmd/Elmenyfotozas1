.ai-hero__side{grid-column:9/span 4;display:grid;gap:1.2rem;justify-items:start;padding-bottom:.6rem}
.tri{position:relative;min-height:0;container-type:size;margin-top:clamp(1.2rem,3vh,2.4rem)}
.tri__in{height:100%;display:flex;justify-content:center;align-items:center;gap:clamp(1rem,2.4vw,2.6rem)}

      var W = table.clientWidth, H2 = table.clientHeight, pad = W < 641 ? 10 : 18;
      var obst = $$('.top__brand,.top__nav ul,.top__menu,.head h1,.head p,.head .btn,.facts dl,.facts .hint', D)
        .filter(function (e) { return e.offsetParent && e.getBoundingClientRect().width; }).map(function (e) { return rel(e, pad * .6); });
      els.forEach(function (el, i) {
        var s = st[i]; if (!s.on) return;
        var rad = 22 * Math.PI / 180, bw = s.w * Math.cos(rad) + s.h * Math.sin(rad), bh = s.w * Math.sin(rad) + s.h * Math.cos(rad);
        var cx = s.x + s.w / 2, cy = s.y + s.h / 2;
        var fin = { l: cx - bw / 2, t: cy - bh / 2, r: cx + bw / 2, b: cy + bh / 2 };
        var dirs = [
          { d: cx, v: [-(fin.r + 30), 0] }, { d: W - cx, v: [W - fin.l + 30, 0] },
          { d: cy, v: [0, -(fin.b + 30)] }, { d: H2 - cy, v: [0, H2 - fin.t + 30] }
        ].sort(function (a, b) { return a.d - b.d; });
        var pick = null;
        for (var k = 0; k < dirs.length && !pick; k++) {
          var v = dirs[k].v;
          var sw = { l: Math.min(fin.l, fin.l + v[0]), r: Math.max(fin.r, fin.r + v[0]), t: Math.min(fin.t, fin.t + v[1]), b: Math.max(fin.b, fin.b + v[1]) };
          if (!obst.some(function (o) { return hit(sw, o); })) pick = v;
        }

  /* ============================================================
     NYOMAT-ASZTAL (főoldali hero)
     Elhelyezés méréssel: minden nyomatnak van egy kedvelt helye, a kereső a legközelebbi
     olyan pontot adja, ahol az elforgatott doboz nem ér a címhez, szöveghez, gombhoz, tényekhez.
     Ledobás: a nyomat a cím középpontjától SUGÁRIRÁNYBAN kifelé eső pontról érkezik, így a pályája
     sosem keresztezi a címet. Húzás után, ha a nyomat kilóg a képből, rugóval visszajön.
     ============================================================ */
  function initTable() {
    var table = $('#table'); if (!table) return;
    var els = $$('.print', table);
    var PD = [[.1, .27, 15, -7], [.9, .42, 15, 6], [.09, .74, 14, 5], [.82, .16, 10, -4], [.72, .8, 12, -3], [.28, .12, 9, 3]];
    var PM = [[.2, .15, 34, -6], [.8, .16, 33, 5], [.2, .76, 30, 4], [.8, .75, 25, -5], [.5, .1, 0, 0], [.5, .1, 0, 0]];
    var st = els.map(function () { return { x: 0, y: 0, r: 0, vx: 0, vy: 0, w: 0, h: 0, on: false }; });
    var z = 20, obstTitle = null;
    function rel(el, pad) {
      var t = table.getBoundingClientRect(), r = el.getBoundingClientRect();
      return { l: r.left - t.left - pad, t: r.top - t.top - pad, r: r.right - t.left + pad, b: r.bottom - t.top + pad };
    }
    function hit(a, b) { return a.l < b.r && a.r > b.l && a.t < b.b && a.b > b.t; }
    function area(a, b) { return Math.max(0, Math.min(a.r, b.r) - Math.max(a.l, b.l)) * Math.max(0, Math.min(a.b, b.b) - Math.max(a.t, b.t)); }
    function apply(el, s) { el.style.transform = 'translate3d(' + s.x + 'px,' + s.y + 'px,0) rotate(' + s.r + 'deg)'; }
    function place() {
      var W = table.clientWidth, H2 = table.clientHeight, mob = W < 641, P = mob ? PM : PD, pad = mob ? 10 : 18;
      var obst = $$('.top__brand,.top__nav ul,.top__menu,.head h1,.head p,.head .btn,.facts dl,.facts .hint', D)
        .filter(function (e) { return e.offsetParent && e.getBoundingClientRect().width; }).map(function (e) { return rel(e, pad); });
      var h1 = $('.head h1', table); obstTitle = h1 ? rel(h1, 0) : null;
      var taken = [];
      els.forEach(function (el, i) {
        var p = P[i], w0 = p[2], r = p[3], ok = null;
        if (!w0) { el.style.display = 'none'; st[i].on = false; return; }
        el.style.display = '';

        // rugó: ha a nyomat kilóg, a kilógás mértékével húz vissza
        var ex = s.x < b.minX ? b.minX - s.x : (s.x > b.maxX ? b.maxX - s.x : 0);
        var ey = s.y < b.minY ? b.minY - s.y : (s.y > b.maxY ? b.maxY - s.y : 0);

        var s = st[i]; s.anim = false;
        sx = e.clientX - s.x; sy = e.clientY - s.y; lx = e.clientX; ly = e.clientY; lt = performance.now(); s.vx = s.vy = 0;
      });
      el.addEventListener('pointermove', function (e) {
        if (!drag) return;

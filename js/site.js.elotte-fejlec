        for (var tries = 0; tries < 7 && !ok; tries++, w *= .87) {
          el.style.setProperty('--w', w + 'px'); el.style.transform = 'none';
          var h = el.offsetHeight, rad = Math.abs(r) * Math.PI / 180;
          var bw = w * Math.cos(rad) + h * Math.sin(rad), bh = w * Math.sin(rad) + h * Math.cos(rad);
          var best = null, bd = 1e12;
          for (var gy = 0; gy <= 40; gy++) for (var gx = 0; gx <= 40; gx++) {
            var cx = bw / 2 + 8 + (W - bw - 16) * gx / 40, cy = bh / 2 + 8 + (H2 - bh - 16) * gy / 40;
            var box = { l: cx - bw / 2, t: cy - bh / 2, r: cx + bw / 2, b: cy + bh / 2 };
            if (obst.some(function (o) { return hit(box, o); })) continue;
            if (taken.some(function (o) { return area(box, o) > .05 * bw * bh; })) continue;
            var d = Math.pow(cx - p[0] * W, 2) + Math.pow(cy - p[1] * H2, 2);
            if (d < bd) { bd = d; best = { cx: cx, cy: cy, box: box }; }
          }
          if (best && Math.sqrt(bd) < Math.max(W, H2) * .34) ok = { cx: best.cx, cy: best.cy, box: best.box, w: w, h: h };
        }
        if (!ok) { el.style.display = 'none'; st[i].on = false; return; }
        taken.push(ok.box);
        var s = st[i]; s.x = ok.cx - ok.w / 2; s.y = ok.cy - ok.h / 2; s.r = r; s.w = ok.w; s.h = ok.h; s.on = true; s.home = { x: s.x, y: s.y };
        apply(el, s);
      });
      table.classList.add('is-placed');
    }
    place();
    (D.fonts ? D.fonts.ready : Promise.resolve()).then(place);
    var rt; addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(place, 120); });

    /* húzás pointer-fizikával */
    els.forEach(function (el, i) {
      var drag = false, sx = 0, sy = 0, lx = 0, ly = 0, lt = 0;
      el.addEventListener('pointerdown', function (e) {

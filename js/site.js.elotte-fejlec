        else { s.x += ex; s.y += ey; apply(el, s); s.anim = false; }
      })();
    }

    /* ledobás: egyenes pálya a képen kívülről. Négy irányt próbálunk (a legközelebbi széltől
       kezdve), és azt választjuk, amelynek a söpört sávja (a kezdő és a végső doboz uniója)
